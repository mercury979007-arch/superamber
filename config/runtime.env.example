# Copy outside the repository, replace absolute paths, and load with
# node --env-file=/absolute/private/runtime.env backend/server.js
NODE_ENV=production
APP_ENV=production
PORT=3001
CNFADMIN_BASE_URL=https://school.example.invalid
ACADEMIC_TIMEZONE=Asia/Shanghai
WEEK1_START=2026-08-31
SESSION_STORE_DIR=/absolute/private/superamber/runtime
CLASSSITDOWN_USAGE_LOG_PATH=/absolute/private/superamber/runtime/usage-events.jsonl
CLASS_DAILY_REPORT_SCRIPT_DIR=/absolute/private/superamber/report-scripts

# Browser fallback: tasks close Chromium when finished, including failures.
# Same-session browser work is serialized. Each queue allows 8 waiting tasks
# for at most 30 seconds; overload returns an error rather than growing forever.
CLASSSITDOWN_BROWSER_TASK_LIMIT=2

# Both sites use this accepted data policy as of 2026-09-09.
# These profiles are required for primary reads. Copy credentials AND their
# companion JSON metadata separately; never commit either to Git.
DAILY_REPORT_TERM_MODE=current
SUPERAMBER_DB_SOURCE_MODE=primary
SUPERAMBER_TASK_DB_PROFILE=/absolute/private/superamber/task-readonly.cnf
SUPERAMBER_RESULT_DB_PROFILE=/absolute/private/superamber/result-readonly.cnf
SUPERAMBER_DB_SOURCE_DOMAINS=roster,checkin,speaking,publicity
SUPERAMBER_DB_SUPPLEMENT_MODE=legacy-compatible
SUPERAMBER_IGNORE_VIDEO_TASKS=1

# Current host explicitly uses 1 for its existing read-only DB connection.
# The target host must verify its DB transport before choosing 0 (TLS) or 1
# (the existing approved non-TLS connection). A missing flag rejects a profile
# without tlsObserved metadata; silently falling back to legacy is not parity.
# SUPERAMBER_DB_ALLOW_INSECURE=0

# Optional external capabilities; transfer these independently of the code repo.
# Required on a fresh host: install Chromium separately; install:all skips it.
PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/chromium
# CLASSROOM_AGENT_ORIGIN=http://127.0.0.1:43217
# SUPERAMBER_PICK_UP_ROOT=/absolute/path/to/pick-up/dist
# SUPERAMBER_L2_PICK_UP_ROOT=/absolute/path/to/l2-pick-up/dist
# CAMP_REPORT_ADMIN_PASSWORD=<provide privately>
# TENCENT_SECRET_ID=<provide privately>
# TENCENT_SECRET_KEY=<provide privately>
# ANTHROPIC_API_KEY=<provide privately>
# VOLC_ASR_APP_ID=<provide privately>
# VOLC_ASR_ACCESS_TOKEN=<provide privately>
# SUPERAMBER_AGENT_SUBJECT_SECRET=<provide privately>
